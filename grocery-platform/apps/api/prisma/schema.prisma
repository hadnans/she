
// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Identity & Access ----------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean       @default(true)
  emailVerifiedAt DateTime?
  roleId        String
  role          Role          @relation(fields: [roleId], references: [id])
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      Wishlist?
  reviews       Review[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  avatarImageId String?
  avatarImage   Image?        @relation("UserAvatar", fields: [avatarImageId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique   // "admin" | "staff" | "customer" | custom roles
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique   // e.g. "products:create", "orders:refund"
  label String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdByIp String?
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  label      String?           // "Home", "Work"
  line1      String
  line2      String?
  city       String
  governorate String?
  country    String   @default("EG")
  postalCode String?
  latitude   Float?            // Maps integration anchor (§10)
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Catalog ----------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  images      Image[]    @relation("CategoryImages")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoImageId String?
  logoImage   Image?  @relation("BrandLogo", fields: [logoImageId], references: [id])
  products Product[]
}

model Product {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?            @relation(fields: [brandId], references: [id])
  basePrice     Int               // minor units
  taxRate       Decimal           @default(0)
  isActive      Boolean           @default(true)
  variants      ProductVariant[]
  images        Image[]           @relation("ProductImages")
  reviews       Review[]
  wishlistItems WishlistItem[]
  erpItemCode   String?           // ERPNext linkage (§9)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
}

model ProductVariant {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  sku         String       @unique
  label       String              // "500g", "1kg", "Pack of 6"
  priceOverride Int?              // null = use Product.basePrice
  barcode     String?             // barcode scanning (§11)
  inventory   Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  isActive    Boolean      @default(true)
}

model Image {
  id          String   @id @default(cuid())
  url         String
  thumbnails  Json                // { sm, md, lg, webp }
  altText     String              // required — accessibility (§3.8)
  sortOrder   Int      @default(0)
  productId   String?
  product     Product? @relation("ProductImages", fields: [productId], references: [id])
  categoryId  String?
  category    Category? @relation("CategoryImages", fields: [categoryId], references: [id])
  brandLogoFor Brand[] @relation("BrandLogo")
  userAvatarFor User[] @relation("UserAvatar")
  bannerId    String?
  banner      Banner?  @relation(fields: [bannerId], references: [id])
  createdAt   DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  linkUrl   String?
  images    Image[]
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int      @default(0)
}

// ---------- Inventory & Suppliers ----------

model Warehouse {
  id         String      @id @default(cuid())
  name       String
  address    String
  latitude   Float?              // Maps integration anchor (§10)
  longitude  Float?
  inventory  Inventory[]
  erpWarehouseCode String?       // ERPNext linkage (§9)
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  contactEmail    String?
  contactPhone    String?
  erpSupplierCode String?        // ERPNext linkage (§9)
  createdAt       DateTime @default(now())
}

model Inventory {
  id              String         @id @default(cuid())
  productVariantId String
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  quantityOnHand  Int            @default(0)
  quantityReserved Int           @default(0)
  reorderLevel    Int            @default(0)
  updatedAt       DateTime       @updatedAt
  @@unique([productVariantId, warehouseId])
}

// ---------- Cart, Orders, Payments ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  @@unique([cartId, productVariantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique   // human-readable, e.g. GR-2026-000123
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  status        OrderStatus  @default(PENDING)
  items         OrderItem[]
  addressId     String
  subtotal      Int
  discountTotal Int          @default(0)
  taxTotal      Int          @default(0)
  deliveryFee   Int          @default(0)
  grandTotal    Int
  couponId      String?
  coupon        Coupon?      @relation(fields: [couponId], references: [id])
  payments      Payment[]
  erpSalesInvoiceId String?         // ERPNext linkage (§9)
  placedAt      DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productNameSnapshot String              // immutable snapshot — product may change/be deleted later
  unitPriceSnapshot   Int
  quantity         Int
  lineTotal        Int
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id])
  provider   String              // "stripe", "paymob", "cod" (§11)
  providerRef String?
  amount     Int
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String            // "PERCENTAGE" | "FIXED"
  discountValue Int
  minOrderTotal Int?
  maxUsage      Int?
  usageCount    Int      @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean  @default(true)
  orders        Order[]
}

// ---------- Engagement ----------

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int               // 1–5
  comment   String?
  isApproved Boolean @default(true)   // admin moderation toggle
  createdAt DateTime @default(now())
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id])
  items  WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  wishlistId String
  wishlist  Wishlist @relation(fields: [wishlistId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())
  @@unique([wishlistId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String            // "in_app" | "email" | "sms" | "push"
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  action     String            // "product.update", "order.refund", ...
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
